MODEL = "qwen3.5-4b"
DEFAULT_BASE_URL = "http://127.0.0.1:8012"
PIN_FLAGS = ["--provider", PROVIDER, "--model", MODEL, "--thinking", "off",
             "-ne", "-ns", "-np", "--no-mcp", "--no-approve"]
SESSION_ID = "claude-delegate"
SESSION_MAX_BYTES = 2 * 1024 * 1024
SHORT_LOG_LINES = 40
KEEP_LOGS = 30
MAX_FAILURES = 15
FALLBACK_LOG_CHARS = 24_000
MAX_LOG_CHARS = 96_000
HEAD_CHARS = 2_000
ANSWER_MAX_LINES = 40
ANSWER_MAX_CHARS = 6_000

EXIT_OK, EXIT_USAGE, EXIT_UNAVAILABLE = 0, 2, 3

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME")
                 or Path.home() / ".local/state") / "pi-delegate"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME")
                 or Path.home() / ".cache") / "pi-delegate"
ASK_PROMPT = Path(os.path.realpath(__file__)).with_name("pi-delegate-ask.md")

ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]"
                  r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
                  r"|\x1b[@-Z\\-_]")


class Unavailable(Exception):
    """The local model can't be used; the message says why."""


def warn(message):
    print(f"pi-delegate: {message}", file=sys.stderr)


# Project

def project_root():
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    cwd = Path.cwd()
    for directory in (cwd, *cwd.parents):
        if (directory / ".pijul").is_dir():
            return directory
    return cwd


def project_key(root):
    name = re.sub(r"[^A-Za-z0-9._-]", "_", root.name) or "root"
    digest = hashlib.sha1(str(root).encode()).hexdigest()[:8]
    return f"{name}-{digest}"


class ProjectLock:
    """One delegate at a time per project: the ask session and the GPU are
    shared, and two builds in one tree trip over each other."""

    def __init__(self, key, deadline):
        self.path = STATE_DIR / "locks" / f"{key}.lock"
        self.deadline = deadline
        self.file = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.file = open(self.path, "w")
        waiting = False
        while True:
            try:
                fcntl.flock(self.file, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if not waiting:
                    warn("waiting for another pi-delegate in this project")
                    waiting = True
                if time.monotonic() >= self.deadline:
                    raise Unavailable("timed out waiting for another "
                                      "pi-delegate in this project")
                time.sleep(0.5)

    def __exit__(self, *_):
        self.file.close()


# Local model

def base_url():
    """The llama-server root, from the provider in Pi's models.json."""
    agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR")
                     or Path.home() / ".pi/agent")
    try:
        models = json.loads((agent_dir / "models.json").read_text())
        url = models["providers"][PROVIDER]["baseUrl"]
        return re.sub(r"/v1/?$", "", url.rstrip("/"))
    except (OSError, ValueError, KeyError, TypeError):
        return DEFAULT_BASE_URL


def preflight():
    """Return the server context size (or None); raise Unavailable fast."""
    if not shutil.which("pi"):
        raise Unavailable("`pi' is not on PATH")
    url = base_url()
    try:
        with urllib.request.urlopen(f"{url}/health", timeout=0.5) as reply:
            if reply.status != 200:
                raise Unavailable(f"llama-server at {url} is not ready "
                                  f"(HTTP {reply.status})")
    except (OSError, ValueError) as error:
        raise Unavailable(f"llama-server at {url} is not reachable "
                          f"({getattr(error, 'reason', error)})")
    try:
        with urllib.request.urlopen(f"{url}/props", timeout=0.5) as reply:
            props = json.load(reply)
        return int(props["default_generation_settings"]["n_ctx"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def kill_group(proc):
    for sig, grace in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            return
        try:
            proc.wait(timeout=grace)
            return
        except subprocess.TimeoutExpired:
            continue


def pi(args, cwd, deadline, stdin_text=None):
    """Run Pi pinned to the local model; return its stdout."""
    command = ["pi", "-p", *PIN_FLAGS, *args]
    proc = subprocess.Popen(
        command, cwd=cwd, text=True, start_new_session=True,
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        out, err = proc.communicate(stdin_text,
                                    timeout=max(1, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        kill_group(proc)
        raise Unavailable("the local model timed out")
    if proc.returncode != 0 or not out.strip():
        lines = [line for line in err.splitlines()
                 if line.strip() and not line.startswith("Warning:")]
        reason = lines[-1] if lines else f"exit {proc.returncode}, no output"
        raise Unavailable(f"pi failed: {reason}")
    return out.strip()


# run

def clean(raw):
    """Output as a terminal would leave it: no escapes, no overwritten
    progress lines."""
    text = ANSI.sub("", raw.decode("utf-8", errors="replace"))
    return "\n".join(line.rstrip("\r").rsplit("\r", 1)[-1]
                     for line in text.split("\n"))


def log_path(key, command):
    directory = CACHE_DIR / key
    directory.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    slug = re.sub(r"[^A-Za-z0-9]+", "-", command).strip("-")[:40] or "command"
    path = directory / f"{stamp}-{slug}.log"
    n = 2
    while path.exists():
        path = directory / f"{stamp}-{slug}-{n}.log"
        n += 1
    return path


def prune_logs(directory):
    logs = sorted(directory.glob("*.log"),
                  key=lambda p: (p.stat().st_mtime, p.name))
    for old in logs[:-KEEP_LOGS]:
        old.unlink(missing_ok=True)


def log_header(command):
    return f"# pi-delegate: $ {command}\n"


def run_command(command, cwd, log, deadline):
    """Run COMMAND in bash, merged output teed to LOG.
    Return (raw output, exit code or None on timeout, seconds)."""
    start = time.monotonic()
    chunks = []
    proc = subprocess.Popen(["bash", "-lc", command], cwd=cwd,
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, start_new_session=True)
    fd = proc.stdout.fileno()
    exited_at = None
    with open(log, "wb") as out:
        out.write(log_header(command).encode())
        while True:
            now = time.monotonic()
            if now >= deadline:
                kill_group(proc)
                return b"".join(chunks), None, now - start
            if exited_at is None and proc.poll() is not None:
                exited_at = now
            # A background child may hold the pipe open after COMMAND exits.
            if exited_at is not None and now - exited_at > 2:
                break
            ready, _, _ = select.select([fd], [], [], 0.2)
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                chunks.append(chunk)
                out.write(chunk)
        code = proc.wait()
        seconds = time.monotonic() - start
        out.write(f"\n# pi-delegate: exit {code} after {seconds:.1f}s\n"
                  .encode())
    proc.stdout.close()
    return b"".join(chunks), code, seconds


def fit(text, n_ctx, reserve=0):
    """Cut the middle out of TEXT so that it fits the model's context, with
    RESERVE characters of it left for what goes along with the log."""
    if n_ctx:
        # Half of the context for the log; ~3 characters per token of a log.
        limit = min(MAX_LOG_CHARS, max(FALLBACK_LOG_CHARS, n_ctx // 2 * 3))
    else:
        limit = FALLBACK_LOG_CHARS
    limit = max(2 * HEAD_CHARS, limit - reserve)
    if len(text) <= limit:
        return text, 0
    head = text[:HEAD_CHARS].rsplit("\n", 1)[0]
    tail = text[-(limit - len(head)):].split("\n", 1)[-1]
    omitted = text.count("\n") - head.count("\n") - tail.count("\n")
    return f"{head}\n[... {omitted} lines omitted ...]\n{tail}", omitted


